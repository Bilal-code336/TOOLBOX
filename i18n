}

.star-two {
    font-size: 14px;
    transform: translate(11px,10px);
}

/* =========================================================
   TOOLBOX AI — MARKDOWN VISUAL
========================================================= */
.toolbox-markdown {
    line-height: 1.65;
    word-break: break-word;
}
.toolbox-markdown p {
    margin: 0 0 12px;
}
.toolbox-markdown p:last-child {
    margin-bottom: 0;
}
.toolbox-markdown h1,
.toolbox-markdown h2,
.toolbox-markdown h3 {
    margin: 18px 0 9px;
    line-height: 1.3;
    color: var(--text);
}
.toolbox-markdown h1 { font-size: 1.45rem; }
.toolbox-markdown h2 { font-size: 1.25rem; }
.toolbox-markdown h3 { font-size: 1.08rem; }
.toolbox-markdown strong {
    font-weight: 800;
    color: var(--text);
}
.toolbox-markdown em { font-style: italic; }
.toolbox-markdown hr {
    border: 0;
    border-top: 1px solid var(--border);
    margin: 18px 0;
}
.toolbox-markdown ul,
.toolbox-markdown ol {
    margin: 8px 0 14px 24px;
    padding: 0;
}
.toolbox-markdown li {
    margin: 5px 0;
}
.toolbox-markdown blockquote {
    margin: 12px 0;
    padding: 8px 14px;
    border-left: 3px solid #8b5cf6;
    color: var(--muted);
    background: rgba(139,92,246,.07);
