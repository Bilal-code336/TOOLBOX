let convertedJPG = null;


function convertPNG() {

    const file =
        document.getElementById(
            "pngFile"
        ).files[0];

    if (!file) return;


    const reader =
        new FileReader();

    reader.onload = function(e) {

        const img =
            new Image();

        img.onload = function() {

            const canvas =
                document.createElement(
                    "canvas"
                );

            canvas.width =
                img.width;

            canvas.height =
                img.height;

            const ctx =
                canvas.getContext(
                    "2d"
                );

            /* Fondo blanco para transparencias */

            ctx.fillStyle =
                "#ffffff";

            ctx.fillRect(
                0,
                0,
                canvas.width,
                canvas.height
            );

            ctx.drawImage(
                img,
                0,
                0
            );

            convertedJPG =
                canvas.toDataURL(
                    "image/jpeg",
                    .92
                );


            const preview =
                document.getElementById(
                    "pngPreview"
                );

            preview.src =
                convertedJPG;

            preview.style.display =
                "block";


            document.getElementById(
                "downloadJPG"
