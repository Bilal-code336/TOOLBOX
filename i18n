    text-align: left;
}
.toolbox-markdown th {
    background: rgba(139,92,246,.10);
    font-weight: 800;
}
.toolbox-markdown img {
    max-width: 100%;
    border-radius: 10px;
}


/* =========================================================
   PLANIFICADOR INTELIGENTE TOOLBOX
========================================================= */

/* El planificador necesita más espacio que las herramientas normales.
   Se ensancha solo este panel para que la semana pueda verse completa. */
.tool-panel#planner {
    width: min(1600px, calc(100vw - 80px));
    margin-left: calc((1150px - min(1600px, calc(100vw - 80px))) / 2);
    box-sizing: border-box;
}

.planner-layout {
    width: 100%;
}

.planner-setup,
.planner-result {
    width: 100%;
    box-sizing: border-box;
}

/* La zona de configuración es más compacta que el calendario semanal. */
.planner-setup {
    width: min(1080px, 100%);
    margin: 0 auto;
}

.planner-result {
    width: 100%;
}

.planner-week-shell {
    width: 100%;
}

.planner-head {
    align-items: flex-start;
}
.planner-head > div:first-child {
    max-width: 900px;
}
.planner-head h2 {
    margin-top: 2px;
}
.planner-head p {
    color: var(--muted);
    margin-top: 7px;
    line-height: 1.55;
}
.planner-eyebrow {
    color: var(--purple3);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin-bottom: 7px;
}
.planner-layout {
    display: grid;
    gap: 20px;
}
.planner-setup, .planner-result {
    background: linear-gradient(180deg, rgba(17,24,39,.98), rgba(13,19,31,.98));
    border: 1px solid var(--border);
    border-radius: 22px;
    padding: 22px;
    box-shadow: 0 18px 50px rgba(0,0,0,.16);
}
body.light .planner-setup, body.light .planner-result {
    background: var(--card);
}
.planner-section-title {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 13px;
}
.planner-section-title > div:first-child {
    display: flex;
    gap: 12px;
}
.planner-section-title h3 {
    font-size: 16px;
    margin-bottom: 4px;
}
.planner-section-title p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.45;
    max-width: 760px;
}
.planner-number {
    width: 31px;
    height: 31px;
    min-width: 31px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(124,58,237,.18);
    border: 1px solid rgba(139,92,246,.4);
    font-size: 11px;
    font-weight: 800;
}
.planner-tasks {
    width: 100%;
    min-height: 165px;
    resize: vertical;
    padding: 16px;
    border-radius: 15px;
    border: 1px solid var(--border);
    background: var(--input);
    color: var(--text);
    outline: none;
    line-height: 1.6;
    font-size: 14px;
    transition: .2s;
}
.planner-tasks:focus {
    border-color: var(--purple2);
    box-shadow: 0 0 0 3px rgba(124,58,237,.12);
}
.planner-availability-title {
    margin-top: 25px;
    align-items: center;
}
.planner-copy-hours {
    border: 1px solid var(--border);
    background: var(--button);
    color: var(--text);
    border-radius: 10px;
    padding: 9px 12px;
    font-size: 12px;
    font-weight: 700;
}
.planner-copy-hours:hover, .planner-same-controls button:hover {
    border-color: var(--purple2);
    color: var(--purple3);
}
.planner-availability {
    display: grid;
    gap: 8px;
}
.planner-day-row {
    display: grid;
    grid-template-columns: 112px 48px minmax(120px,1fr) 22px minmax(120px,1fr);
    align-items: center;
    gap: 9px;
    padding: 10px 11px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: rgba(8,13,22,.45);
}
body.light .planner-day-row { background: var(--card2); }
.planner-day-name { font-weight: 800; font-size: 13px; }
.planner-day-row input[type=time] {
    width: 100%;
    min-width: 0;
    padding: 8px 9px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--input);
    color: var(--text);
}
.planner-day-row input:disabled { opacity: .35; }
.planner-switch { position: relative; width: 40px; height: 22px; }
.planner-switch input { opacity: 0; width: 0; height: 0; }
.planner-slider {
    position: absolute; inset: 0; cursor: pointer; border-radius: 999px; background: #263044; transition: .2s;
}
.planner-slider:before {
    content: ''; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; border-radius: 50%; background: #fff; transition: .2s;
}
.planner-switch input:checked + .planner-slider { background: var(--purple); }
.planner-switch input:checked + .planner-slider:before { transform: translateX(18px); }
.planner-same-hours {
    display:flex; justify-content:space-between; align-items:center; gap:15px;
    margin-top:12px; padding:13px 14px; border-radius:13px; border:1px solid var(--border); background:rgba(124,58,237,.06);
}
.planner-same-hours strong { display:block; font-size:13px; }
.planner-same-hours span { color:var(--muted); font-size:12px; }
.planner-same-controls { display:flex; align-items:center; gap:7px; }
.planner-same-controls input { padding:8px 9px; border-radius:9px; border:1px solid var(--border); background:var(--input); color:var(--text); }
.planner-same-controls button { border:1px solid var(--border); background:var(--button); color:var(--text); padding:8px 12px; border-radius:9px; font-weight:700; }
.planner-actions { display:flex; justify-content:flex-end; gap:9px; margin-top:16px; }
.planner-generate { min-width:180px; }
.planner-status { min-height:20px; color:var(--muted); font-size:12px; margin-top:10px; text-align:right; }
.planner-result { padding: 20px; }
.planner-result-top { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; }
.planner-result-top h3 { font-size:22px; margin-bottom:5px; }
.planner-result-top p { color:var(--muted); line-height:1.5; max-width:800px; }
.planner-result-actions { display:flex; gap:8px; flex-wrap:wrap; }
.planner-insights { display:flex; flex-wrap:wrap; gap:8px; margin:17px 0 13px; }
.planner-chip { padding:8px 11px; border-radius:999px; border:1px solid var(--border); background:var(--card2); color:var(--muted); font-size:12px; }
.planner-chip strong { color:var(--text); }
.planner-week-shell { border:1px solid var(--border); border-radius:18px; overflow:hidden; background:var(--input); }
.planner-week-scroll { overflow:auto; padding:0; }
.planner-week-grid {
    min-width:1450px;
    display:grid;
    grid-template-columns:64px repeat(7, minmax(190px, 1fr));
}
.planner-time-head { height:78px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); }
.planner-day-head {
    height:78px; padding:13px 10px; border-right:1px solid var(--border); border-bottom:1px solid var(--border); background:rgba(17,24,39,.75);
}
body.light .planner-day-head { background:var(--card2); }
.planner-day-head strong { display:block; font-size:13px; }
.planner-day-head small { display:block; margin-top:4px; color:var(--muted); font-size:11px; }
.planner-day-head .planner-day-total { margin-top:8px; color:var(--purple3); font-weight:800; font-size:11px; }
.planner-time-axis { position:relative; border-right:1px solid var(--border); background:rgba(8,13,22,.3); }
.planner-time-label { position:absolute; left:7px; transform:translateY(-50%); color:var(--muted); font-size:10px; font-weight:700; }
.planner-track { position:relative; border-right:1px solid var(--border); background:repeating-linear-gradient(to bottom, transparent 0, transparent 59px, rgba(137,149,170,.11) 60px); }
.planner-track:last-child { border-right:0; }
.planner-off-hours { position:absolute; left:0; right:0; background:repeating-linear-gradient(135deg, rgba(52,65,88,.18) 0, rgba(52,65,88,.18) 7px, transparent 7px, transparent 14px); pointer-events:none; }
.planner-free-label { position:absolute; inset:0; display:grid; place-items:center; color:rgba(137,149,170,.28); font-size:11px; pointer-events:none; }
.planner-block { position:absolute; left:7px; right:7px; padding:10px 10px 9px; border-radius:12px; background:linear-gradient(135deg, #7c3aed, #6d28d9); color:#fff; box-shadow:0 8px 22px rgba(0,0,0,.22); overflow:hidden; z-index:2; min-height:40px; cursor:default; transition:transform .15s, box-shadow .15s; }
.planner-block:hover { transform:translateY(-1px); box-shadow:0 12px 28px rgba(0,0,0,.28); }
.planner-block.done { opacity:.45; text-decoration:line-through; }
.planner-block.urgent { box-shadow:inset 3px 0 #f59e0b, 0 8px 22px rgba(0,0,0,.22); }
.planner-block .planner-block-title { font-weight:800; font-size:12px; line-height:1.25; }
.planner-block .planner-block-time { font-size:10px; opacity:.85; margin-top:4px; }
.planner-block .planner-block-meta { display:flex; gap:5px; flex-wrap:wrap; margin-top:7px; }
.planner-mini-btn { border:0; background:rgba(255,255,255,.16); color:#fff; border-radius:7px; padding:4px 6px; font-size:9px; font-weight:800; cursor:pointer; }
.planner-mini-btn:hover { background:rgba(255,255,255,.27); }
.planner-free { position:absolute; left:8px; right:8px; border:1px dashed rgba(137,149,170,.22); border-radius:10px; color:var(--muted); display:flex; align-items:center; justify-content:center; font-size:10px; }
.planner-note { margin-top:13px; padding:12px 14px; border-radius:12px; border:1px solid var(--border); background:rgba(124,58,237,.05); color:var(--muted); font-size:12px; line-height:1.5; }
@media (max-width:1180px) {
    .tool-panel#planner {
        width: calc(100vw - 40px);
        margin-left: 0;
    }
}

@media (max-width:800px) {
    .tool-panel#planner {
        width: 100%;
    }
    .planner-day-row { grid-template-columns:90px 42px 1fr 14px 1fr; gap:6px; padding:8px; }
    .planner-same-hours, .planner-result-top { flex-direction:column; align-items:stretch; }
    .planner-same-controls { flex-wrap:wrap; }
    .planner-actions { justify-content:stretch; }
    .planner-actions button { flex:1; }
}

/* =========================================================
   FOOTER
========================================================= */

footer {

    margin-top:
        80px;

    padding:
        45px 20px;

    text-align:
        center;

    border-top:
        1px solid var(--border);

    color:
        var(--muted);
}

footer strong {
    color:
        var(--purple2);
}


/* =========================================================
   IDIOMAS, ACCESIBILIDAD Y MEJORAS
========================================================= */

.skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: 10000;
    padding: 9px 16px;
    border-radius: 10px;
    background: var(--purple);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
}

.skip-link:focus { left: 12px; }

:focus-visible {
    outline: 2px solid var(--purple3);
    outline-offset: 2px;
}

.logo { color: inherit; text-decoration: none; }

.flag {
    width: 22px;
    height: 15px;
    flex: 0 0 auto;
    display: block;
    border-radius: 3px;
    box-shadow: 0 0 0 1px rgba(128,128,128,.35);
}

.lang-switch { position: relative; }

.lang-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 12px;
    border-radius: 11px;
    border: 1px solid var(--border);
    background: var(--button);
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: .4px;
    transition: border-color .2s, transform .2s, box-shadow .2s;
}

.lang-btn:hover {
    border-color: var(--purple2);
    transform: translateY(-1px);
    box-shadow: 0 0 18px rgba(139,92,246,.25);
}

.lang-btn .caret { font-size: 10px; opacity: .7; transition: transform .2s; }
.lang-btn[aria-expanded="true"] .caret { transform: rotate(180deg); }

.lang-menu {
    position: absolute;
    right: 0;
    top: 48px;
    z-index: 6000;
    min-width: 190px;
    padding: 6px;
    list-style: none;
    border-radius: 14px;
    border: 1px solid var(--border2);
    background: var(--panel);
    box-shadow: 0 18px 50px rgba(0,0,0,.35);
    animation: langPop .18s ease;
}

@keyframes langPop {
    from { opacity: 0; transform: translateY(-6px) scale(.97); }
    to { opacity: 1; transform: none; }
}

.lang-menu a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 9px;
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
}

.lang-menu a:hover,
.lang-menu a:focus-visible { background: var(--button); }
.lang-menu a[aria-current="true"] { background: rgba(124,58,237,.16); font-weight: 700; }
.lang-menu .check { margin-left: auto; color: var(--purple3); }

.lang-tag {
    display: inline-block;
    margin-left: 6px;
    padding: 1px 6px;
    border-radius: 6px;
    border: 1px solid var(--border2);
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .5px;
    vertical-align: middle;
}

.lang-hint {
    position: fixed;
    left: 50%;
    bottom: 22px;
    z-index: 9000;
    transform: translateX(-50%);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px;
    max-width: calc(100% - 28px);
    padding: 12px 16px;
    border-radius: 14px;
    border: 1px solid var(--border2);
    background: var(--panel);
    box-shadow: 0 18px 50px rgba(0,0,0,.4);
    font-size: 14px;
    animation: langPop .3s ease;
}

.lang-hint a {
    padding: 8px 14px;
    border-radius: 10px;
    background: var(--purple);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
}

.lang-hint button {
    width: 30px;
    height: 30px;
    border: none;
    border-radius: 8px;
    background: var(--button);
    color: var(--text);
}

body.light .search {
    background: #fff;
    box-shadow: 0 15px 50px rgba(15,23,42,.08);
}

body.light .search input { color: var(--text); }

.tool-sub { color: var(--muted); margin-top: 6px; font-size: 14px; line-height: 1.5; }

.no-results {
    margin-top: 22px;
    padding: 26px;
