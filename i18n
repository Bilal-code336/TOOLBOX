    border-radius:
        18px;

    padding:
        40px 20px;

    text-align:
        center;

    transition:
        .2s;
}

.drop-zone:hover {

    border-color:
        var(--purple2);

    background:
        rgba(124,58,237,.05);
}

.image-preview {

    display:
        none;

    max-width:
        100%;

    max-height:
        420px;

    margin:
        25px auto;

    border-radius:
        15px;
}

/* =========================================================
   EDITOR DE IMAGEN
========================================================= */

.image-editor {

    display:
        grid;

    grid-template-columns:
        minmax(0,1fr) 270px;

    gap:
        20px;
}

.canvas-area {

    min-height:
        450px;

    display:
        flex;

    align-items:
        center;

    justify-content:
        center;

    background:
        #05080e;

    border:
        1px solid var(--border);

    border-radius:
        17px;

    overflow:
        hidden;

    padding:
        20px;
}

#editorCanvas {

    max-width:
        100%;

    max-height:
        550px;

    display:
        none;

    border-radius:
        8px;
}

.editor-controls {

    background:
        var(--card2);

    border:
        1px solid var(--border);

    border-radius:
        17px;

    padding:
        18px;
}

.control-group {

    margin-bottom:
        18px;
}

.control-group label {

    display:
        flex;

    justify-content:
        space-between;

    color:
        var(--muted);

    font-size:
        13px;

    margin-bottom:
        8px;
}

.control-group input[type="range"] {

    padding:
        0;

    border:
        none;

    box-shadow:
        none;
}

/* =========================================================
   SIMPLIFICADOR
========================================================= */

.ai-mini {

    background:
        linear-gradient(
            135deg,
            rgba(124,58,237,.15),
            rgba(17,24,39,.8)
        );

    border:
        1px solid
        rgba(139,92,246,.35);

    padding:
        20px;

    border-radius:
        17px;

    margin-bottom:
        20px;
}

/* Botón flotante que abre la página independiente de TOOLBOX AI */
.toolbox-ai-button {

    position:
        fixed;

    right:
        24px;

    bottom:
        24px;

    width:
        64px;

    height:
        64px;

    border:
        1px solid
        rgba(255,255,255,.12);

    border-radius:
        19px;

    background:
        linear-gradient(
            145deg,
            #20283a,
            #0b1019
        );

    box-shadow:
        0 15px 45px
