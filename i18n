<script src="https://cdn.jsdelivr.net/npm/tesseract.js@6/dist/tesseract.min.js"></script>


<script>
/* =========================================================
   TEMPORIZADOR POMODORO
========================================================= */

let pomodoroInterval = null;
let pomodoroRunning = false;
let pomodoroMode = "focus";
let pomodoroSeconds = 25 * 60;
let pomodoroSession = 1;

const pomodoroTotalSessions = 4;


function pomodoroGetMinutes(id, fallback) {

    const value =
        parseInt(
            document.getElementById(id).value,
            10
        );

    if (Number.isNaN(value) || value < 1) {
        return fallback;
    }

    return value;
}


function pomodoroDurationForMode() {

    if (pomodoroMode === "focus") {

        return pomodoroGetMinutes(
            "pomodoroFocusMinutes",
            25
        ) * 60;

    }

    if (pomodoroMode === "short") {

        return pomodoroGetMinutes(
            "pomodoroShortMinutes",
            5
        ) * 60;

    }

    return pomodoroGetMinutes(
        "pomodoroLongMinutes",
        15
    ) * 60;
}


function pomodoroUpdateDisplay() {

    const minutes =
        Math.floor(
            pomodoroSeconds / 60
        )
        .toString()
        .padStart(2, "0");

    const seconds =
        (pomodoroSeconds % 60)
        .toString()
        .padStart(2, "0");

    document.getElementById("pomodoroTime").innerText =
        `${minutes}:${seconds}`;


    const modeElement =
        document.getElementById("pomodoroMode");

    const box =
        document.getElementById("pomodoroBox");


    box.classList.remove(
        "focus-mode",
        "short-break-mode",
        "long-break-mode"
    );


    if (pomodoroMode === "focus") {

        modeElement.innerText =
            t('pomo_focus');

        box.classList.add("focus-mode");

    } else if (pomodoroMode === "short") {

        modeElement.innerText =
            t('pomo_short');

        box.classList.add("short-break-mode");

    } else {

        modeElement.innerText =
            t('pomo_long');

        box.classList.add("long-break-mode");
    }


    document.getElementById("pomodoroSessions").innerText =
        t('pomo_session', {n: pomodoroSession, total: pomodoroTotalSessions});


    document.getElementById("pomodoroPlay").innerText =
        pomodoroRunning
        ? t('pomo_pause')
        : t('pomo_start');
}


function pomodoroPlayPause() {

    if (pomodoroRunning) {

        clearInterval(pomodoroInterval);

        pomodoroInterval = null;
        pomodoroRunning = false;

        pomodoroUpdateDisplay();

        return;
    }


    if (
        "Notification" in window &&
        Notification.permission === "default"
    ) {

        Notification.requestPermission();

    }


    pomodoroRunning = true;

    pomodoroUpdateDisplay();


    pomodoroInterval =
        setInterval(
            pomodoroTick,
            1000
        );
}


function pomodoroTick() {

    if (pomodoroSeconds > 0) {

        pomodoroSeconds--;

        pomodoroUpdateDisplay();

        return;
    }


    pomodoroFinishPhase();
}


function pomodoroFinishPhase() {

    clearInterval(pomodoroInterval);

    pomodoroInterval = null;
    pomodoroRunning = false;


    let title = "";
    let message = "";


    if (pomodoroMode === "focus") {

        if (pomodoroSession >= pomodoroTotalSessions) {

            title = t('pomo_t_all');
            message =
                t('pomo_m_all');

            pomodoroMode = "long";

        } else {

            title = t('pomo_t_session');
            message =
                t('pomo_m_session');

            pomodoroMode = "short";
        }

    } else if (pomodoroMode === "short") {

        title = t('pomo_t_break');
        message =
            t('pomo_m_break');

        pomodoroSession++;
        pomodoroMode = "focus";

    } else {

        title = t('pomo_t_long');
        message =
            t('pomo_m_long');

        pomodoroSession = 1;
        pomodoroMode = "focus";
    }


    if (
        "Notification" in window &&
        Notification.permission === "granted"
    ) {

        new Notification(
            title,
            {
                body: message
            }
        );

    }


    if (document.visibilityState === "visible") {

        alert(
            `${title}\n\n${message}`
        );

    }


    pomodoroSeconds =
        pomodoroDurationForMode();

    pomodoroUpdateDisplay();


    // La siguiente fase empieza automáticamente.
    pomodoroRunning = true;

    pomodoroUpdateDisplay();

    pomodoroInterval =
        setInterval(
            pomodoroTick,
            1000
        );
}


function pomodoroReset() {

    clearInterval(pomodoroInterval);

    pomodoroInterval = null;
    pomodoroRunning = false;
    pomodoroMode = "focus";
    pomodoroSession = 1;

    pomodoroSeconds =
        pomodoroDurationForMode();

    pomodoroUpdateDisplay();
}


function pomodoroSkip() {

    clearInterval(pomodoroInterval);

    pomodoroInterval = null;

    const wasRunning =
        pomodoroRunning;

    pomodoroRunning = false;


    if (pomodoroMode === "focus") {

        if (pomodoroSession >= pomodoroTotalSessions) {

            pomodoroMode = "long";

        } else {

            pomodoroMode = "short";
        }

    } else if (pomodoroMode === "short") {

        pomodoroSession++;
        pomodoroMode = "focus";

    } else {

        pomodoroSession = 1;
        pomodoroMode = "focus";
    }


    pomodoroSeconds =
        pomodoroDurationForMode();

    pomodoroUpdateDisplay();


    if (wasRunning) {

        pomodoroRunning = true;

        pomodoroUpdateDisplay();

        pomodoroInterval =
            setInterval(
                pomodoroTick,
                1000
            );
    }
}



/* =========================================================
   DETECTOR DE TEXTO DE IMAGEN — OCR
========================================================= */

async function procesarOCR(event) {

    const file =
        event.target.files[0];

    if (!file) return;


    const preview =
        document.getElementById("ocrPreview");

    const progressWrap =
        document.getElementById("ocrProgressWrap");

    const progress =
        document.getElementById("ocrProgress");

    const status =
        document.getElementById("ocrStatus");

    const result =
        document.getElementById("ocrResult");

    const copyButton =
        document.getElementById("ocrCopyButton");


    result.value = "";
    copyButton.disabled = true;

    progress.style.width = "0%";

    progressWrap.style.display = "block";


    preview.src =
        URL.createObjectURL(file);

    preview.style.display = "block";


    status.innerText =
        t('ocr_preparing');


    try {

        const worker =
            await Tesseract.createWorker(
                t('ocr_lang'),
                1,
                {
                    logger: function(info) {

                        if (info.status) {

                            status.innerText =
                                info.status;

                        }

                        if (
                            typeof info.progress === "number"
                        ) {

                            progress.style.width =
                                `${Math.round(info.progress * 100)}%`;
                        }
                    }
                }
            );


        const resultOCR =
            await worker.recognize(file);


        await worker.terminate();


        result.value =
            resultOCR.data.text.trim();


        progress.style.width =
            "100%";


        if (result.value) {

            status.innerText =
                t('ocr_ok');

            copyButton.disabled = false;

        } else {

            status.innerText =
                t('ocr_none');
        }

    } catch (error) {

        console.error(error);

        status.innerText =
            t('ocr_fail');

    }
}


async function copiarOCR() {

    const text =
        document
            .getElementById("ocrResult")
            .value;


    if (!text.trim()) {

        alert(
            t('ocr_first')
        );

        return;
    }


    try {

        await navigator.clipboard.writeText(text);

        alert(
            t('ocr_copied')
        );

    } catch {

        const textarea =
            document.getElementById("ocrResult");

        textarea.select();

        document.execCommand("copy");

        alert(
            t('ocr_copied')
        );
