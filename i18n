/* =========================================================
   PLANIFICADOR INTELIGENTE — TOOLBOX AI
========================================================= */
const PLANNER_STORAGE_KEY = 'toolbox_planner_plan' + (LANG === 'es' ? '' : '_' + LANG);
const plannerDays = [
    {key:'lun', name:t('day_mon'), short:t('day_mon_s'), enabled:true, start:'17:00', end:'21:00'},
    {key:'mar', name:t('day_tue'), short:t('day_tue_s'), enabled:true, start:'16:00', end:'20:00'},
    {key:'mie', name:t('day_wed'), short:t('day_wed_s'), enabled:true, start:'17:00', end:'21:00'},
    {key:'jue', name:t('day_thu'), short:t('day_thu_s'), enabled:true, start:'16:00', end:'21:00'},
    {key:'vie', name:t('day_fri'), short:t('day_fri_s'), enabled:true, start:'16:00', end:'19:00'},
    {key:'sab', name:t('day_sat'), short:t('day_sat_s'), enabled:true, start:'10:00', end:'14:00'},
    {key:'dom', name:t('day_sun'), short:t('day_sun_s'), enabled:false, start:'10:00', end:'14:00'}
];

let plannerLastPlan = null;

function plannerInit() {
    const wrap = document.getElementById('plannerAvailability');
    if (!wrap || wrap.dataset.ready === '1') return;
    wrap.dataset.ready = '1';
    wrap.innerHTML = plannerDays.map((d, i) => `
        <div class="planner-day-row">
            <span class="planner-day-name">${d.name}</span>
            <label class="planner-switch" title="${t("planner_activate")} ${d.name}">
                <input type="checkbox" id="plannerEnabled_${i}" ${d.enabled ? 'checked' : ''} onchange="plannerSyncDay(${i})">
                <span class="planner-slider"></span>
            </label>
            <input type="time" id="plannerStart_${i}" value="${d.start}" ${d.enabled ? '' : 'disabled'} onchange="plannerSyncDay(${i})">
            <span style="color:var(--muted);text-align:center;">→</span>
            <input type="time" id="plannerEnd_${i}" value="${d.end}" ${d.enabled ? '' : 'disabled'} onchange="plannerSyncDay(${i})">
        </div>`).join('');
}

function plannerSyncDay(i) {
    const en = document.getElementById(`plannerEnabled_${i}`);
    const st = document.getElementById(`plannerStart_${i}`);
    const ed = document.getElementById(`plannerEnd_${i}`);
    if (!en || !st || !ed) return;
    plannerDays[i].enabled = en.checked;
    st.disabled = !en.checked;
    ed.disabled = !en.checked;
    if (en.checked && st.value >= ed.value) {
        ed.value = st.value === '23:00' ? '23:59' : `${String(Number(st.value.slice(0,2))+1).padStart(2,'0')}:${st.value.slice(3)}`;
    }
    plannerDays[i].start = st.value;
    plannerDays[i].end = ed.value;
}

function plannerReadAvailability() {
    plannerDays.forEach((d, i) => plannerSyncDay(i));
    return plannerDays.map(d => ({...d}));
}

function plannerCopyMonday() {
    plannerInit();
    const start = document.getElementById('plannerStart_0').value;
    const end = document.getElementById('plannerEnd_0').value;
    const enabled = document.getElementById('plannerEnabled_0').checked;
    for (let i=1;i<plannerDays.length;i++) {
        document.getElementById(`plannerEnabled_${i}`).checked = enabled;
        document.getElementById(`plannerStart_${i}`).value = start;
        document.getElementById(`plannerEnd_${i}`).value = end;
        plannerSyncDay(i);
    }
    plannerSetStatus(t('planner_same_monday'));
}

function plannerApplySameHours() {
    plannerInit();
    const start = document.getElementById('plannerSameStart').value;
    const end = document.getElementById('plannerSameEnd').value;
    if (!start || !end || start >= end) { alert(t('planner_time_error')); return; }
    for (let i=0;i<7;i++) {
        document.getElementById(`plannerEnabled_${i}`).checked = true;
        document.getElementById(`plannerStart_${i}`).value = start;
        document.getElementById(`plannerEnd_${i}`).value = end;
        plannerSyncDay(i);
    }
    plannerSetStatus(t('planner_same_all'));
}

function plannerSetStatus(text) {
    const el=document.getElementById('plannerStatus');
    if(el) el.innerText=text || '';
}

function plannerToggleSetup() {
    const setup=document.querySelector('.planner-setup');
    if(setup) setup.scrollIntoView({behavior:'smooth', block:'start'});
}

function plannerClear() {
    if (!confirm(t('planner_clear_confirm'))) return;
    document.getElementById('plannerTasks').value='';
    document.getElementById('plannerResult').style.display='none';
    document.getElementById('plannerInsights').innerHTML='';
    document.getElementById('plannerWeek').innerHTML='';
    plannerLastPlan=null;
    localStorage.removeItem(PLANNER_STORAGE_KEY);
    plannerSetStatus('');
}

function plannerMinutes(t) {
    const [h,m]=t.split(':').map(Number);
    return h*60+m;
}

function plannerTime(min) {
    const h=Math.floor(min/60).toString().padStart(2,'0');
    const m=(min%60).toString().padStart(2,'0');
    return `${h}:${m}`;
}

function plannerEsc(text) {
    return String(text ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function plannerExtractJSON(text) {
    let clean = String(text || '').trim();

    // Quitar bloques Markdown si el modelo los añade aunque se le haya pedido JSON.
    clean = clean.replace(/^```(?:json)?\s*/i, '').replace(/\s*```$/i, '').trim();

    try {
        return JSON.parse(clean);
    } catch {}

    // Buscar el primer objeto JSON completo aunque haya texto antes/después.
    const first = clean.indexOf('{');
    if (first >= 0) {
        let depth = 0;
        let inString = false;
        let escaped = false;
        for (let i = first; i < clean.length; i++) {
            const ch = clean[i];
            if (inString) {
                if (escaped) escaped = false;
                else if (ch === '\\') escaped = true;
                else if (ch === '"') inString = false;
                continue;
            }
            if (ch === '"') { inString = true; continue; }
            if (ch === '{') depth++;
            else if (ch === '}') {
                depth--;
                if (depth === 0) {
                    try { return JSON.parse(clean.slice(first, i + 1)); } catch {}
                    break;
                }
            }
        }
    }

    throw new Error(t('planner_bad_json'));
}

function plannerValidatePlan(plan, availability) {
    if (!plan || !Array.isArray(plan.days)) {
        throw new Error(t('planner_bad_days'));
    }

    const byDay = new Map(availability.map(d => [d.name.toLowerCase(), d]));

    plan.days = plan.days.map(day => {
        const dayName = String(day?.day || '').trim();
        const cfg = byDay.get(dayName.toLowerCase());
        const blocks = Array.isArray(day?.blocks) ? day.blocks : [];

        return {
            day: dayName,
            blocks: blocks.filter(b => {
                if (!b || !b.task || !b.start || !b.end) return false;
                const start = String(b.start).slice(0, 5);
                const end = String(b.end).slice(0, 5);
                if (!/^\d{2}:\d{2}$/.test(start) || !/^\d{2}:\d{2}$/.test(end)) return false;
                if (plannerMinutes(end) <= plannerMinutes(start)) return false;
                // No permitimos bloques fuera del horario introducido por el usuario.
                if (cfg?.enabled) {
                    if (plannerMinutes(start) < plannerMinutes(cfg.start) || plannerMinutes(end) > plannerMinutes(cfg.end)) return false;
                }
                return true;
            }).map(b => ({
                task: String(b.task),
                start: String(b.start).slice(0, 5),
                end: String(b.end).slice(0, 5),
                priority: String(b.priority || 'normal'),
                deadline: String(b.deadline || ''),
                note: String(b.note || '')
            })).sort((a, b) => plannerMinutes(a.start) - plannerMinutes(b.start))
        };
    });

    // Si el modelo no devuelve alguno de los días, lo añadimos vacío.
    const existing = new Set(plan.days.map(d => d.day.toLowerCase()));
    availability.forEach(d => {
        if (!existing.has(d.name.toLowerCase())) plan.days.push({ day: d.name, blocks: [] });
    });

    return plan;
}

async function generarPlanificador() {
    plannerInit();

    const tasks = document.getElementById('plannerTasks').value.trim();
    if (!tasks) {
        alert(t('planner_write_first'));
        return;
    }

    const availability = plannerReadAvailability();
    const active = availability.filter(d => d.enabled && d.start < d.end);

    if (!active.length) {
        alert(t('planner_activate_day'));
        return;
    }

    const button = document.getElementById('plannerGenerate');
    button.disabled = true;
    button.innerText = t('planner_loading');
    plannerSetStatus(t('planner_status_creating'));

    // IMPORTANTE: el planificador hace UNA sola petición y no manda
    // historial de conversación. Esto reduce muchísimo el consumo.
    const availabilityText = availability
        .map(d => `${d.name}:${d.enabled ? d.start + '-' + d.end : t('planner_free_word')}`)
        .join('|');

    // Limitar el tamaño evita que un pegado accidentalmente enorme
    // consuma una cantidad innecesaria de tokens.
    const tasksForAI = tasks.length > 9000 ? tasks.slice(0, 9000) : tasks;

    const prompt = t('prompt_planner', {tasks: tasksForAI, availability: availabilityText});

    try {
        // UNA ÚNICA PETICIÓN. Los reintentos automáticos provocaban
        // más 429 cuando Groq ya estaba limitando la cuenta.
        const reply = await askGemini(
            [{ role: 'user', content: prompt }],
            'normal'
        );

        const plan = plannerValidatePlan(
            plannerExtractJSON(reply),
            availability
        );

        plan.availability = availability;
        plannerLastPlan = plan;

        localStorage.setItem(
            PLANNER_STORAGE_KEY,
            JSON.stringify(plan)
        );

        plannerRender(plan, availability);
        document.getElementById('plannerResult').style.display = 'block';
        plannerSetStatus(t('planner_done'));

        setTimeout(() => {
            document.getElementById('plannerResult').scrollIntoView({
                behavior: 'smooth',
                block: 'start'
            });
        }, 80);

    } catch (error) {
        console.error('TOOLBOX Planner:', error);

        let message = error?.message || t('planner_unknown');

        if (message.includes('429') || /too many requests/i.test(message)) {
            message = t('planner_rate_limit');
        }

        plannerSetStatus('⚠️ ' + message);
        alert(t('planner_fail') + '\n\n' + message);

    } finally {
        button.disabled = false;
        button.innerText = t('planner_button');
    }
}

function plannerRender(plan, availability) {
    const active=availability.filter(d=>d.enabled && d.start<d.end);
    const activeNames=new Set(active.map(d=>d.name.toLowerCase()));
    const dayMap=new Map(active.map(d=>[d.name.toLowerCase(),d]));
    const days=plannerDays.map(d=>({
        ...d,
        config:dayMap.get(d.name.toLowerCase()),
        data:(plan.days||[]).find(x=>String(x.day||'').toLowerCase()===d.name.toLowerCase()) || {blocks:[]}
    }));
    const allBlocks=days.flatMap(d=>(d.data.blocks||[]).map(b=>({...b,day:d.name})));
    const times=allBlocks.flatMap(b=>[plannerMinutes(b.start),plannerMinutes(b.end)]);
    const starts=active.map(d=>plannerMinutes(d.start));
    const ends=active.map(d=>plannerMinutes(d.end));
    let minHour=Math.floor(Math.min(...(times.length?times:starts))/60);
    let maxHour=Math.ceil(Math.max(...(times.length?times:ends))/60);
    minHour=Math.max(6,Math.min(minHour,22));
    maxHour=Math.min(24,Math.max(maxHour,minHour+6));
    const totalMinutes=(maxHour-minHour)*60;
    const pxPerMinute=1.05;
    const trackHeight=Math.round(totalMinutes*pxPerMinute);

    const insights=(plan.insights||[]).map(x=>`<div class="planner-chip">${plannerEsc(x)}</div>`).join('');
    const pending=(plan.pending||[]).filter(Boolean);
    const pendingHtml=pending.length?`<div class="planner-chip">📌 <strong>${pending.length}</strong> ${t(pending.length===1?'planner_pending_one':'planner_pending_many')}</div>`:'';
    document.getElementById('plannerInsights').innerHTML=insights+pendingHtml+`<div class="planner-chip">⏱️ <strong>${Math.round(allBlocks.reduce((a,b)=>a+(plannerMinutes(b.end)-plannerMinutes(b.start)),0)/60*10)/10} h</strong> ${t('planner_planned')}</div>`;
    document.getElementById('plannerResultTitle').innerText=plan.title||t('planner_title_default');
    document.getElementById('plannerResultSummary').innerText=plan.summary||t('planner_summary_default');

    const header=`<div class="planner-time-head"></div>${days.map(d=>`<div class="planner-day-head"><strong>${d.short}</strong><small>${d.config?d.config.start+'–'+d.config.end:t('planner_unavailable')}</small><div class="planner-day-total">${Math.round((d.data.blocks||[]).reduce((a,b)=>a+(plannerMinutes(b.end)-plannerMinutes(b.start)),0)/6)/10} h</div></div>`).join('')}`;
    const axis=Array.from({length:maxHour-minHour+1},(_,i)=>{const y=i*60*pxPerMinute;return `<span class="planner-time-label" style="top:${y}px">${String(minHour+i).padStart(2,'0')}:00</span>`;}).join('');

    const tracks=days.map(d=>{
        const cfg=d.config;
        const before=cfg?Math.max(0,plannerMinutes(cfg.start)-minHour*60):0;
        const after=cfg?Math.max(0,maxHour*60-plannerMinutes(cfg.end)):totalMinutes;
        const dayBlocks=(d.data.blocks||[]).filter(b=>plannerMinutes(b.end)>plannerMinutes(b.start));
        const blockHtml=dayBlocks.map((b,i)=>{
            const top=(plannerMinutes(b.start)-minHour*60)*pxPerMinute;
            const height=Math.max(40,(plannerMinutes(b.end)-plannerMinutes(b.start))*pxPerMinute-6);
            const urgent=/alta|high|urg|haut|[ée]lev/i.test(String(b.priority));
            return `<div class="planner-block ${urgent?'urgent':''}" style="top:${top}px;height:${height}px" title="${plannerEsc(b.note||'')}" data-planner-day="${plannerEsc(d.name)}" data-planner-task="${plannerEsc(b.task)}">
                <div class="planner-block-title">${plannerEsc(b.task)}</div>
                <div class="planner-block-time">${plannerEsc(b.start)} – ${plannerEsc(b.end)}</div>
                <div class="planner-block-meta">
                    ${b.deadline?`<span class="planner-mini-btn">📌 ${plannerEsc(b.deadline)}</span>`:''}
                    <button class="planner-mini-btn" onclick="plannerMarkDone(this)">${t('planner_mark_done')}</button>
                </div>
            </div>`;
        }).join('');
        const offTop=before;
        const offBottom=after;
        return `<div class="planner-track" style="height:${trackHeight}px">
            ${!cfg?`<div class="planner-free-label">${t('planner_free_day')}</div>`:''}
            ${cfg&&offTop>0?`<div class="planner-off-hours" style="top:0;height:${offTop*pxPerMinute}px"></div>`:''}
            ${cfg&&offBottom>0?`<div class="planner-off-hours" style="bottom:0;height:${offBottom*pxPerMinute}px"></div>`:''}
            ${cfg&&!dayBlocks.length?`<div class="planner-free" style="top:${before*pxPerMinute+10}px;height:${Math.max(44,(totalMinutes-before-offBottom)*pxPerMinute-20)}px">${t('planner_free_time')}</div>`:''}
            ${blockHtml}
        </div>`;
    }).join('');
    document.getElementById('plannerWeek').innerHTML=`<div class="planner-week-grid" style="grid-template-rows:78px ${trackHeight}px">${header}<div class="planner-time-axis" style="height:${trackHeight}px">${axis}</div>${tracks}</div>`;
}

function plannerMarkDone(button) {
    const block=button.closest('.planner-block');
    if(!block) return;
    block.classList.toggle('done');
    button.innerText=block.classList.contains('done')?t('planner_undo'):t('planner_mark_done');
}

function plannerLoadSaved() {
    try {
        const saved=JSON.parse(localStorage.getItem(PLANNER_STORAGE_KEY)||'null');
        if(saved && saved.days && saved.availability) {
            plannerLastPlan=saved;
            plannerRender(saved,saved.availability);
            document.getElementById('plannerResult').style.display='block';
        }
    } catch(e) { console.warn(t('planner_load_fail'),e); }
}

const plannerOriginalAbrir = window.abrir;
window.abrir = function(id) {
    if(typeof plannerOriginalAbrir==='function') plannerOriginalAbrir(id);
    if(id==='planner') {
        setTimeout(()=>{ plannerInit(); plannerLoadSaved(); },60);
    }
};


/* =========================================================
   SELECTOR DE IDIOMA, AVISO DE IDIOMA, ENLACES #HERRAMIENTA
========================================================= */

(function () {

    const switcher = document.getElementById("langSwitch");

    if (switcher) {

        const button = document.getElementById("langBtn");
        const menu = document.getElementById("langMenu");

        const close = () => {
            menu.hidden = true;
            button.setAttribute("aria-expanded", "false");
        };

        button.addEventListener("click", event => {

            event.stopPropagation();

            const opening = menu.hidden;

            menu.hidden = !opening;

            button.setAttribute("aria-expanded", String(opening));

            if (opening) {
                const current = menu.querySelector('[aria-current="true"]') || menu.querySelector("a");
                if (current) current.focus();
            }

        });

        document.addEventListener("click", event => {
            if (!switcher.contains(event.target)) close();
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && !menu.hidden) {
                close();
                button.focus();
            }
        });

        menu.querySelectorAll("a[data-lang]").forEach(link => {
            link.addEventListener("click", () => {
                try { localStorage.setItem("toolboxLang", link.dataset.lang); } catch (e) {}
                link.href = link.getAttribute("href").split("#")[0] + location.hash;
            });
        });

    }

    /* Aviso amable si el navegador está en otro idioma disponible */

    const HINTS = {
        es: { text: "Esta página también está disponible en español.", cta: "Ver en español", href: "/" },
        en: { text: "This site is also available in English.", cta: "View in English", href: "/en/" },
        fr: { text: "Ce site est aussi disponible en français.", cta: "Voir en français", href: "/fr/" }
    };

    let chosen = "";
    let dismissed = "";

    try {
        chosen = localStorage.getItem("toolboxLang") || "";
        dismissed = localStorage.getItem("toolboxLangHint") || "";
    } catch (e) {}

    const browser = (navigator.language || "").slice(0, 2).toLowerCase();

    if (HINTS[browser] && browser !== LANG && !chosen && !dismissed) {

        const hint = document.createElement("div");

        hint.className = "lang-hint";
        hint.setAttribute("role", "region");
        hint.setAttribute("lang", browser);

        const text = document.createElement("span");
        text.textContent = HINTS[browser].text;

        const link = document.createElement("a");
        link.href = HINTS[browser].href + location.hash;
        link.textContent = HINTS[browser].cta;
        link.addEventListener("click", () => {
            try { localStorage.setItem("toolboxLang", browser); } catch (e) {}
        });

        const closeButton = document.createElement("button");
        closeButton.type = "button";
        closeButton.textContent = "✕";
        closeButton.setAttribute("aria-label", "Close");
        closeButton.addEventListener("click", () => {
            try { localStorage.setItem("toolboxLangHint", "1"); } catch (e) {}
            hint.remove();
        });

        hint.append(text, link, closeButton);
        document.body.appendChild(hint);

    }

})();

