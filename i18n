========================================================= */

.password-result {

    display:
        flex;

    align-items:
        center;

    gap:
        10px;
}

.password-result input {

    font-family:
        Consolas,
        monospace;

    font-size:
        18px;
}

.option-grid {

    display:
        grid;

    grid-template-columns:
        repeat(auto-fit,minmax(180px,1fr));

    gap:
        10px;

    margin-top:
        15px;
}

.check-option {

    display:
        flex;

    align-items:
        center;

    gap:
        8px;

    padding:
        12px;

    background:
        var(--input);

    border:
