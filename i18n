========================================================= */

let editorImage = null;

let editorRotation = 0;

let editorFlip = false;

let editorGray = false;


function loadEditorImage(event) {

    const file =
        event.target.files[0];

    if (!file) return;


    const reader =
        new FileReader();


    reader.onload = function(e) {

        editorImage =
            new Image();

        editorImage.onload =
            function() {

                editorRotation =
                    0;

                editorFlip =
                    false;

                editorGray =
                    false;

                document.getElementById(
                    "editorCanvas"
                ).style.display =
                    "block";

                document.getElementById(
                    "editorEmpty"
                ).style.display =
                    "none";

                resetEditorControls();

                drawEditor();

            };

        editorImage.src =
            e.target.result;

    };


    reader.readAsDataURL(file);

}


function resetEditorControls() {

    document.getElementById(
        "brightnessControl"
    ).value = 100;

    document.getElementById(
        "contrastControl"
    ).value = 100;

    document.getElementById(
        "saturationControl"
    ).value = 100;

    updateEditorLabels();

}


function updateEditor() {

    updateEditorLabels();

    drawEditor();

}


function updateEditorLabels() {

    document.getElementById(
        "brightnessValue"
    ).innerText =
        document.getElementById(
            "brightnessControl"
        ).value + "%";


    document.getElementById(
        "contrastValue"
    ).innerText =
        document.getElementById(
            "contrastControl"
        ).value + "%";


    document.getElementById(
        "saturationValue"
    ).innerText =
        document.getElementById(
            "saturationControl"
        ).value + "%";

}


function drawEditor() {

    if (!editorImage) return;


    const canvas =
        document.getElementById(
            "editorCanvas"
        );

    const ctx =
        canvas.getContext(
            "2d"
        );


    const angle =
        editorRotation *
        Math.PI /
        180;


    const rotated =
        editorRotation === 90 ||
        editorRotation === 270;


    canvas.width =
        rotated
        ? editorImage.height
        : editorImage.width;

    canvas.height =
        rotated
        ? editorImage.width
        : editorImage.height;


    ctx.save();


    ctx.translate(
        canvas.width / 2,
        canvas.height / 2
    );


    ctx.rotate(angle);


    if (editorFlip) {

        ctx.scale(-1,1);

    }


    const brightness =
        document.getElementById(
            "brightnessControl"
        ).value;

    const contrast =
        document.getElementById(
            "contrastControl"
        ).value;

    const saturation =
        document.getElementById(
            "saturationControl"
        ).value;


    ctx.filter =
        `brightness(${brightness}%)
         contrast(${contrast}%)
         saturate(${saturation}%)
         ${editorGray ? "grayscale(100%)" : ""}`;


    ctx.drawImage(
        editorImage,
        -editorImage.width / 2,
        -editorImage.height / 2
    );


    ctx.restore();

}


function rotateEditor() {

    if (!editorImage) return;

    editorRotation =
        (editorRotation + 90) % 360;

    drawEditor();

}


function flipEditor() {

    if (!editorImage) return;

    editorFlip =
        !editorFlip;

    drawEditor();

}


function grayEditor() {

    if (!editorImage) return;

    editorGray =
        !editorGray;

    drawEditor();

}


function resetEditor() {

    if (!editorImage) return;

    editorRotation = 0;

    editorFlip = false;

    editorGray = false;

    resetEditorControls();

    drawEditor();

}


function downloadEditor() {

    if (!editorImage) {

        alert(
            t('img_load_first')
