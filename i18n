function actualizarEstilo() {

    const input =
        document.getElementById(
            "stylerInput"
        ).value;

    if (!input) {

        document.getElementById(
            "stylerResult"
        ).innerText =
            t('styler_empty');

        return;

    }

    const style =
        unicodeStyles[currentStyle];

    let result = "";

    for (const char of input) {

        const index =
            style.normal.indexOf(char);

        if (index >= 0) {

            const styledChars = Array.from(style.styled);

result +=
    styledChars[index] || char;

        } else {

            result += char;

        }

    }

    document.getElementById(
        "stylerResult"
    ).innerText =
        result;

}


