========================================================= */

function updateColor() {

    const color =
        document.getElementById(
            "colorPicker"
        ).value;

    document.getElementById(
        "colorPreview"
    ).style.background = color;

    document.getElementById(
        "colorPreview"
    ).innerText =
        color.toUpperCase();

    document.getElementById(
        "colorCode"
    ).innerText =
        color.toUpperCase();

}


function randomColor() {

    const chars =
        "0123456789ABCDEF";

    let color = "#";

    for (
        let i = 0;
        i < 6;
        i++
    ) {

        color +=
            chars[
                Math.floor(
                    Math.random() *
                    chars.length
                )
            ];

    }

    document.getElementById(
        "colorPicker"
    ).value =
        color;

    updateColor();

}


async function copyColor() {

    const text =
        document.getElementById(
            "colorCode"
        ).innerText;

    await navigator.clipboard.writeText(text);

    alert(t('color_copied'));

}


