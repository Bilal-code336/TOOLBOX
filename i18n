function transformarCaracter(caracter) {

    const conversiones = {
        "a": "a",
        "e": "e",
        "i": "i",
        "o": "0",
                
    };

    return conversiones[caracter] || caracter;
}


function transformarPalabra(palabra) {

    let resultado = "";

    for (const caracter of palabra) {
        resultado += transformarCaracter(caracter);
    }

    return resultado;
}


