}
.toolbox-markdown pre code {
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    white-space: pre;
}
.toolbox-markdown a {
    color: #a78bfa;
    text-decoration: underline;
    text-underline-offset: 2px;
}
.toolbox-markdown table {
    width: 100%;
    border-collapse: collapse;
    margin: 14px 0;
    font-size: .94em;
}
.toolbox-markdown th,
.toolbox-markdown td {
    border: 1px solid var(--border);
