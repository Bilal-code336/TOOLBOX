========================================================= */

const LANG = {{LANG_JSON}};
const I18N = {{I18N_JSON}};

function t(key, vars) {
    let text = (I18N[key] !== undefined) ? I18N[key] : key;
    if (vars) {
        text = text.replace(/\{(\w+)\}/g, (m, name) => (vars[name] !== undefined ? vars[name] : m));
    }
    return text;
}

/* =========================================================
   ABRIR / CERRAR HERRAMIENTAS
========================================================= */

function abrir(id) {

    cerrar();

    const panel =
        document.getElementById(id);

    if (!panel) return;

    panel.classList.add("active");

    setTimeout(() => {

        panel.scrollIntoView({
            behavior: "smooth",
            block: "start"
        });

    }, 50);
}


function cerrar() {

    document
        .querySelectorAll(".tool-panel")
        .forEach(panel => {

            panel.classList.remove("active");

        });

}


/* =========================================================
   TEMA
========================================================= */

function tema() {

    document.body.classList.toggle("light");

    const light = document.body.classList.contains("light");

    syncThemeButton();

    try {
        localStorage.setItem("toolboxTheme", light ? "light" : "dark");
    } catch (e) {}

}

function syncThemeButton() {

    const button = document.getElementById("themeButton");

    if (!button) return;

    const light = document.body.classList.contains("light");

    button.innerText = light ? "☀️" : "🌙";
}


/* =========================================================
   BUSCADOR
========================================================= */

let currentCategory = "all";

function normalizeText(text) {
    return String(text || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
}

function applyToolFilters() {

    const input = document.getElementById("search");

    const query = normalizeText(input ? input.value.trim() : "");

    let visible = 0;

    document
        .querySelectorAll(".tool-card")
        .forEach(card => {

            const matchesCategory =
                currentCategory === "all" ||
                card.dataset.category === currentCategory;

            const matchesText =
                !query ||
                normalizeText(card.dataset.name + " " + card.innerText).includes(query);

            const show = matchesCategory && matchesText;

            card.style.display = show ? "" : "none";

            if (show) visible++;

        });

    const none = document.getElementById("noResults");

    if (none) none.hidden = visible > 0;

}

function buscar() {

    applyToolFilters();

}

function filtrar(categoria, boton) {

    currentCategory = categoria;

    document
        .querySelectorAll(".category")
        .forEach(b => {

            b.classList.remove("selected");

        });

    boton.classList.add("selected");

    applyToolFilters();

}




/* =========================================================
   CALCULADORA
========================================================= */

function calcAdd(valor) {

    const screen =
        document.getElementById("calcScreen");

    if (
        screen.value === "0" ||
        screen.value === "Error"
    ) {

        screen.value = valor;

    } else {

        screen.value += valor;

    }

}


function calcClear() {

    document.getElementById(
        "calcScreen"
    ).value = "0";

}


function calcDelete() {

    const screen =
        document.getElementById("calcScreen");

    screen.value =
        screen.value.slice(0,-1);

    if (!screen.value) {
        screen.value = "0";
    }

}


function calcResult() {

    const screen =
        document.getElementById("calcScreen");

    try {

        if (
            !/^[0-9+\-*/%.() ]+$/
            .test(screen.value)
        ) {

            throw new Error();

        }

        const resultado =
            Function(
                "return " + screen.value
            )();

        if (
            !Number.isFinite(resultado)
        ) {

            throw new Error();

        }

        screen.value =
            resultado;

    } catch {

        screen.value =
            "Error";

    }

}


/* =========================================================
